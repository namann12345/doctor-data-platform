# ============================================================
# Doctor Data Platform — .gitignore
# ============================================================

# ── Python / Backend ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Virtual environments
venv/
env/
.env/
.venv/
ENV/

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# SQLite databases
*.db
*.sqlite
*.sqlite3

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
dist/
build/
.vite/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build info
*.tsbuildinfo

# ── IDE & Editor ────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
.DS_Store
Thumbs.db

# ── OS ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ── Misc ────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
